#!/bin/sh
# ---------------------------------------------------------------------------
# Hook pre-push: muestra SIEMPRE el destino real del push.
#
# Existe porque este repo SOLO debe vivir en una carpeta local. Con varias
# copias del repo en el PC era imposible saber desde cual se publicaba.
# Este hook imprime la URL de destino, la rama y la carpeta de trabajo
# antes de que se envie nada.
# ---------------------------------------------------------------------------

# Contrato de git para pre-push:
#   $1 = nombre del remote   $2 = URL del remote   $3 = ref local que se empuja
remote_name="$1"
remote_url="$(git remote get-url --push "$remote_name" 2>/dev/null)"
[ -z "$remote_url" ] && remote_url="$2"
local_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
remote_ref="$3"

if [ -z "$remote_ref" ]; then
    remote_ref="(rama actual: $local_branch)"
else
    remote_ref="${remote_ref#refs/heads/}"
fi

echo ""
echo "================================================================"
echo "  PUSH DESTINO  : ${remote_url:-<sin remote>}  (remote: ${remote_name})"
echo "  RAMA LOCAL    : ${local_branch}"
echo "  RAMA REMOTA   : ${remote_ref}"
echo "  CARPETA       : $(pwd)"
echo "  COMMIT        : $(git rev-parse --short HEAD) $(git log -1 --pretty=%s)"
echo "================================================================"
echo ""

# Aviso si quedan cambios sin commitear (no bloquea el push).
if [ -n "$(git status --porcelain)" ]; then
    echo "  AVISO: hay cambios sin commitear en el working tree."
    echo ""
fi

exit 0
