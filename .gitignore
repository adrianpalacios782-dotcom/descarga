# ============================================================
# osvaldoDownloaderPro — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
htmlcov/
.coverage
.coverage.*
*.coverage

# ---------- Secrets / Credenciales ----------
.env
.env.*
!.env.example
*.secret
secrets/
credentials/
cookies.txt
cookies*.txt
*_cookie.txt
client_secret*.json
*.pem
*.key
*.p12
*.pfx
netrc
.netrc

# Configuracion REAL de firma de codigo (contiene thumbprint del certificado).
# Nunca commitear. Plantilla segura: scripts/signing.config.example.json
scripts/signing.config.json

# Certificados sueltos adicionales
*.crt
*.cer

# ---------- Binarios grandes / artefactos de instalador ----------
# ffmpeg.exe y ffprobe.exe (~98 MB c/u): se obtienen localmente, no van al repo.
# Ver docs/BETA_TESTING.md y scripts/build_release.ps1 para reproducir el build.
/bin/
# Salida del compilador Inno Setup (Setup.exe): va como Release Asset de GitHub.
/installer/

# ---------- Bases de datos locales ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# ---------- Temporales / descargas a medio terminar ----------
*.tmp
*.temp
*.part
*.download
*.crdownload
*.ytdl
*.aria2
*~

# ---------- Multimedia descargada ----------
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.mp3
*.m4a
*.wav
*.flac
*.ogg
*.opus
*.3gp
*.m3u8

# ---------- Logs ----------
*.log
logs/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.suo
*.user
*.swp

# ---------- OpenCode / temporales del asistente ----------
.opencode/
.temp/
.tmp-opencode/
opencode-temp/
*.opencode.tmp

# ---------- Scratch / diagnostico local ----------
# Scripts de depuracion, servidores HTTP locales de prueba y capturas.
# Nunca forman parte del repositorio publico.
scratch/

# ---------- Sistema ----------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.bak
*.orig
